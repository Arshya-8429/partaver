# Template only. Generate real credentials with pnpm release:credentials.
# Save the actual file outside the release tree, readable only by its owner.
NODE_ENV=production
PORT=8787
PARTAVAR_PUBLIC_ORIGIN=https://partavar.example.invalid
PARTAVAR_AUTH_USERNAME=operator
PARTAVAR_AUTH_TOKEN_SHA256=REPLACE_WITH_GENERATED_SHA256
CATALOGUE_DB_PATH=/var/lib/partavar/private-data/sqlite/catalogue.db
CATALOGUE_DATA_ROOT=/var/lib/partavar/private-data
PARTAVAR_OPERATIONS_PATH=/var/lib/partavar/private-data/sqlite/operations.db
PARTAVAR_WEB_ROOT=/opt/partavar/current/apps/web/dist
